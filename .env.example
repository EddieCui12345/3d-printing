# Set these in Vercel: Project Settings > Environment Variables. Never commit real values.
# From the Square Developer Dashboard (https://developer.squareup.com/apps):
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" for test payments, "production" for real ones.
SQUARE_ENVIRONMENT=sandbox
# Optional. Where Square sends shoppers after paying. Defaults to the site's own address.
SITE_URL=
