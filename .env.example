# Set these in Vercel: Project Settings > Environment Variables. Never commit real values.
# From the Square Developer Dashboard (https://developer.squareup.com/apps):
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" for test payments, "production" for real ones.
# On Vercel this must be set to production. A production token sent to the sandbox fails.
SQUARE_ENVIRONMENT=sandbox
# Optional. Where Square sends shoppers after paying. Defaults to the site's own address.
SITE_URL=

# One Gmail address for Steamoji North. It sends both order emails and receives the club's copy.
# emailAppPassword is a Google app password (Google Account > Security > 2-Step Verification
# > App passwords), not the normal Gmail password. Spaces in the app password are fine.
email=
emailAppPassword=

# Optional, and recommended. In the Square dashboard, subscribe to payment.updated and set
# the notification URL to https://YOUR-SITE/api/square-webhook. Paste that exact URL and the
# signature key here so the emails still send if a buyer closes the tab before coming back.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
